# Copy this file to backend/.env and replace the placeholder locally.
# Spring Boot reads it when started with backend as the working directory.
DB_USERNAME=sa
DB_PASSWORD=<your-sql-server-password>

# PDF hóa đơn: thông tin CT286 Invoicing là bên bán khi bán, bên mua khi mua.
# Giữ tên biến SELLER để tương thích cấu hình đã dùng; MST/địa chỉ mặc định để trống.
INVOICE_SELLER_NAME=CT286 Invoicing
INVOICE_SELLER_VAT=
INVOICE_SELLER_ADDRESS=
